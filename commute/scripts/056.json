      "spoken_meaning": "名词，接待员，前台",
      "en": "The receptionist will issue visitor badges in the lobby.",
      "zh": "前台接待员将在大厅发放访客证。"
    },
    {
      "word": "lobby",
      "spelling": "L, O, B, B, Y",
      "spoken_meaning": "名词，大厅，门厅",
      "en": "Guests should wait in the lobby until their host arrives.",
      "zh": "访客应在大厅等候接待人到来。"
    },
    {
      "word": "lounge",
      "spelling": "L, O, U, N, G, E",
      "spoken_meaning": "名词，休息室，候机室",
      "en": "The departure lounge has power outlets near every seating area.",
      "zh": "出发休息室每个座位区附近都有电源插座。"
    },
    {
      "word": "hallway",
      "spelling": "H, A, L, L, W, A, Y",
      "spoken_meaning": "名词，走廊，过道",
      "en": "Fire exits at both ends of the hallway must remain clear.",
      "zh": "走廊两端的消防出口必须保持畅通。"
    },
    {
      "word": "restroom",
      "spelling": "R, E, S, T, R, O, O, M",
      "spoken_meaning": "名词，洗手间",
      "en": "The restroom on this floor is temporarily closed for maintenance.",
      "zh": "本层洗手间因维修暂时关闭。"
    },
    {
      "word": "folder",
      "spelling": "F, O, L, D, E, R",
      "spoken_meaning": "名词，文件夹",
      "en": "Please put the signed contracts in the blue folder on my desk.",
      "zh": "请把已签字的合同放进我桌上的蓝色文件夹。"
    },
    {
      "word": "highlighter",
      "spelling": "H, I, G, H, L, I, G, H, T, E, R",
      "spoken_meaning": "名词，荧光笔",
      "en": "Use a highlighter to mark revised clauses in the contract.",
      "zh": "请用荧光笔标出合同中修订过的条款。"
    },
    {
      "word": "printer",
      "spelling": "P, R, I, N, T, E, R",
      "spoken_meaning": "名词，打印机",
      "en": "The network printer is offline until the technician replaces the drum.",
      "zh": "在技术员更换硒鼓之前，网络打印机将处于脱机状态。"
    },
    {
      "word": "fax",
      "spelling": "F, A, X",
      "spoken_meaning": "名词或动词，传真，发传真",
      "en": "If email is down, fax the purchase order to the supplier.",
      "zh": "如果电子邮件无法使用，请把采购订单传真给供应商。"
    },
    {
      "word": "inbox",
      "spelling": "I, N, B, O, X",
      "spoken_meaning": "名词，收件箱",
      "en": "Please check your inbox for the revised travel itinerary.",
      "zh": "请查看收件箱中的修订版行程。"
    },
    {
      "word": "outbox",
      "spelling": "O, U, T, B, O, X",
      "spoken_meaning": "名词，发件箱",
      "en": "The message is still in the outbox because the server is busy.",
      "zh": "由于服务器繁忙，该邮件仍在发件箱中。"
    },
    {
      "word": "attachment",
      "spelling": "A, T, T, A, C, H, M, E, N, T",
      "spoken_meaning": "名词，附件",
      "en": "The price list is in the attachment, not in the body of the email.",
      "zh": "价目表在附件里，不在邮件正文中。"
    },
    {
      "word": "cc",
      "spelling": "C, C",
      "spoken_meaning": "名词或动词，抄送",
      "en": "Please cc the project sponsor on all budget change requests.",
      "zh": "所有预算变更申请请抄送项目发起人。"
    },
    {
      "word": "bcc",
      "spelling": "B, C, C",
      "spoken_meaning": "名词或动词，密送",
      "en": "Use bcc when writing to a large group of external guests.",
      "zh": "给大批外部来宾写信时请使用密送。"
    },
    {
      "word": "subject-line",
      "spelling": "S, U, B, J, E, C, T, hyphen, L, I, N, E",
      "spoken_meaning": "名词，邮件主题行",
      "en": "A clear subject-line helps the finance team file the request quickly.",
      "zh": "清晰的主题行有助于财务团队迅速归档申请。"
    },
    {
      "word": "thread",
      "spelling": "T, H, R, E, A, D",
      "spoken_meaning": "名词，邮件对话串，线程",
      "en": "Please keep the discussion in the same email thread.",
      "zh": "请把讨论留在同一封邮件对话串里。"
    },
    {
      "word": "reply-all",
      "spelling": "R, E, P, L, Y, hyphen, A, L, L",
      "spoken_meaning": "动词或名词，全部回复",
      "en": "Avoid reply-all unless everyone on the copy list needs the update.",
      "zh": "除非抄送名单上的每个人都需要了解进展，否则不要全部回复。"
    },
    {
      "word": "circular",
      "spelling": "C, I, R, C, U, L, A, R",
      "spoken_meaning": "名词，传阅通知，通函",
      "en": "A circular was sent to all branches about the holiday opening hours.",
      "zh": "已向各分店发出关于节日营业时间的通函。"
    },
    {
      "word": "flyer",
      "spelling": "F, L, Y, E, R",
      "spoken_meaning": "名词，传单，广告单",
      "en": "Please put a stack of flyers next to the registration desk.",
      "zh": "请在登记台旁边放一叠传单。"
    },
    {
      "word": "leaflet",
      "spelling": "L, E, A, F, L, E, T",
      "spoken_meaning": "名词，单页传单，说明书",
      "en": "A safety leaflet is included with every power tool.",
      "zh": "每件电动工具都附有一份安全说明单页。"
    },
    {
      "word": "envelope",
      "spelling": "E, N, V, E, L, O, P, E",
      "spoken_meaning": "名词，信封",
      "en": "Please seal the confidential papers in a plain envelope.",
      "zh": "请把机密文件装进空白信封并封好。"
    },
    {
      "word": "postage",
      "spelling": "P, O, S, T, A, G, E",
      "spoken_meaning": "名词，邮资",
      "en": "Overnight postage for the samples will be billed to the client.",
      "zh": "样品的隔夜邮资将向客户收取。"
    },
    {
      "word": "mailbox",
      "spelling": "M, A, I, L, B, O, X",
      "spoken_meaning": "名词，邮箱，信箱",
      "en": "Checks should be dropped in the locked mailbox by the finance office.",
      "zh": "支票请投入财务办公室旁上锁的信箱。"
    },
    {
      "word": "postage-meter",
      "spelling": "P, O, S, T, A, G, E, hyphen, M, E, T, E, R",
      "spoken_meaning": "名词，邮资机",
      "en": "The postage-meter needs a new ink cartridge before the mailing.",
      "zh": "这次邮寄前，邮资机需要更换墨盒。"
    },
    {
      "word": "registered-mail",
      "spelling": "R, E, G, I, S, T, E, R, E, D, hyphen, M, A, I, L",
      "spoken_meaning": "名词，挂号邮件",
      "en": "Send the original certificates by registered-mail, not by regular post.",
      "zh": "原件证书请用挂号邮件寄送，不要用普通平邮。"
    },
    {
      "word": "certified-mail",
      "spelling": "C, E, R, T, I, F, I, E, D, hyphen, M, A, I, L",
      "spoken_meaning": "名词，保证邮件，签收邮件",
      "en": "The termination notice was sent by certified-mail with a return receipt.",
      "zh": "解约通知已通过保证邮件寄出，并要求回执。"
    },
    {
      "word": "return-receipt",
      "spelling": "R, E, T, U, R, N, hyphen, R, E, C, E, I, P, T",
      "spoken_meaning": "名词，回执，签收证明",
      "en": "Request a return-receipt so we can confirm the client received the contract.",
      "zh": "请索取回执，以便确认客户已收到合同。"
    },
    {
      "word": "tracking-number",
      "spelling": "T, R, A, C, K, I, N, G, hyphen, N, U, M, B, E, R",
      "spoken_meaning": "名词，运单号，物流跟踪号",
      "en": "Please send me the tracking-number as soon as the shipment leaves the warehouse.",
      "zh": "货物一离开仓库，请立刻把运单号发给我。"
    },
    {
      "word": "waybill",
      "spelling": "W, A, Y, B, I, L, L",
      "spoken_meaning": "名词，运单",
      "en": "The driver cannot unload the goods without a signed waybill.",
      "zh": "没有已签字的运单，司机不能卸货。"
    },
    {
      "word": "air-waybill",
      "spelling": "A, I, R, hyphen, W, A, Y, B, I, L, L",
      "spoken_meaning": "名词，航空运单",
      "en": "The air-waybill number is required for the customs declaration.",
      "zh": "办理报关需要航空运单号。"
    }
